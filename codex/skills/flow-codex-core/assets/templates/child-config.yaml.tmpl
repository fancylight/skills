# Flow 子 Agent 配置
# 由 $flow-codex-init 自动生成

project:
  name: "{{project.name}}"
  role: "executor"
  root_path: "{{root_path}}"
  service_name: "{{service_name}}"

knowledge_base:
  enabled: {{knowledge_base.enabled}}
  path: "{{knowledge_base.path}}"
  overview: "{{knowledge_base.overview}}"
  maintenance_guide: "{{knowledge_base.maintenance_guide}}"
  child_write: {{knowledge_base.child_write}}

conventions:
  task_id_prefix: "{{conventions.task_id_prefix}}"
  branch_pattern: "{{conventions.branch_pattern}}"
  commit_format: "{{conventions.commit_format}}"

child_agent:
  spec_tool: "{{child_agent.spec_tool}}"
  onboarding_doc: "{{root_path}}/.flow/onboarding.md"

inline_agents:
  review:
    enabled: true
    knowledge_base_rules_path: ""
  unit_test:
    enabled: true
    test_command: "{{test_command}}"
  knowledge_maintenance:
    enabled: true
    auto_trigger: false
